+    passing_attempts:ssotInt(stat?.passing_attempts ?? stat?.pass_attempts), passing_completions:ssotInt(stat?.passing_completions ?? stat?.completions),
+    passing_yards:ssotNum(stat?.passing_yards), passing_touchdowns:ssotInt(stat?.passing_touchdowns ?? stat?.passing_tds),
+    interceptions:ssotInt(stat?.interceptions ?? stat?.interceptions_thrown),
+    rushing_attempts:ssotInt(stat?.rushing_attempts ?? stat?.rush_attempts), rushing_yards:ssotNum(stat?.rushing_yards),
+    rushing_touchdowns:ssotInt(stat?.rushing_touchdowns ?? stat?.rushing_tds),
+    targets:ssotInt(stat?.receiving_targets ?? stat?.targets), receptions:ssotInt(stat?.receptions),
+    receiving_yards:ssotNum(stat?.receiving_yards), receiving_touchdowns:ssotInt(stat?.receiving_touchdowns ?? stat?.receiving_tds),
