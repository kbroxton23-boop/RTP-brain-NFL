+    const seed = await ssotBdlGenericPage(env,"games",{seasons:[season],season_type:2,per_page:1});
+    seedGameId = ssotInt(seed?.data?.[0]?.id);
+    rows.push(await ssotBdlProbe(env,"team_roster","GOAT","teams/1/roster",{season}));
+    rows.push(await ssotBdlProbe(env,"advanced_passing","GOAT","advanced_stats/passing",{season,season_type:2,week:0,per_page:1}));
+    rows.push(await ssotBdlProbe(env,"advanced_rushing","GOAT","advanced_stats/rushing",{season,season_type:2,week:0,per_page:1}));
+    rows.push(await ssotBdlProbe(env,"advanced_receiving","GOAT","advanced_stats/receiving",{season,season_type:2,week:0,per_page:1}));
+    if (seedGameId) rows.push(await ssotBdlProbe(env,"plays","GOAT","plays",{game_id:seedGameId,per_page:1}));
+    else rows.push({endpoint_key:"plays",required_tier:"GOAT",accessible:null,http_status:0,checked_at:new Date().toISOString(),sample_count:null,detail:"no_seed_game"});
+  } else if (group === "market") {
+    const seed = await ssotBdlGenericPage(env,"games",{seasons:[season],season_type:2,per_page:1});
+    seedGameId = ssotInt(seed?.data?.[0]?.id);
+    rows.push(await ssotBdlProbe(env,"odds","GOAT","odds",{season,week:1,season_type:2,per_page:1}));
+    if (seedGameId) rows.push(await ssotBdlProbe(env,"player_props","GOAT","odds/player_props",{game_id:seedGameId,prop_type:"passing_yards"}));
+    else rows.push({endpoint_key:"player_props",required_tier:"GOAT",accessible:null,http_status:0,checked_at:new Date().toISOString(),sample_count:null,detail:"no_seed_game"});
+  } else {
+    throw new Error("ssot_invalid_capability_group");
+  }
+  await ssotPersistCapabilities(env, rows);
+  return { group, season, seed_game_id: seedGameId, endpoints: rows, build: BUILD, model_math_mutated: false };
+}
+function ssotPlayerName(player) {
+  return [ssotText(player?.first_name), ssotText(player?.last_name)].filter(Boolean).join(" ") || null;
+}
+function ssotNormalizePlayer(player, observedAt) {
