+  return {
+    player_id: playerId, first_name: ssotText(player?.first_name), last_name: ssotText(player?.last_name),
+    player_name: ssotPlayerName(player), position: ssotText(player?.position), position_abbreviation: ssotText(player?.position_abbreviation),
+    height: ssotText(player?.height), weight: ssotText(player?.weight), jersey_number: ssotText(player?.jersey_number),
+    college: ssotText(player?.college), experience: ssotText(player?.experience), age: ssotInt(player?.age),
+    current_team_id: ssotInt(team?.id), current_team_abbr: ssotText(team?.abbreviation)?.toUpperCase() || null,
+    source: NFL_SSOT_PROVIDER, observed_at: observedAt, ingested_at: observedAt, schema_version: NFL_SSOT_SCHEMA_VERSION, build: BUILD
+  };
+}
+function ssotNormalizePlayerStat(stat, seasonType, observedAt) {
