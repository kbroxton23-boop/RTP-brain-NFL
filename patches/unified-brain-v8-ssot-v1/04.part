+async function ssotUpsertRows(env, phase, rows, archive) {
+  let stored = 0;
+  for (let i = 0; i < rows.length; i += 25) {
+    const group = rows.slice(i, i + 25);
+    const statements = [];
+    for (const r of group) {
+      const rowHash = await ssotSha256(r);
+      if (phase === "games") statements.push(env.NFL_DB.prepare(SSOT_GAME_UPSERT).bind(
+        r.game_id,r.bdl_game_id,r.season,r.week,r.season_type,r.kickoff_at,r.status_state,r.status_text,r.postseason,r.venue,r.summary,r.home_team_id,r.home_team_abbr,r.home_team_name,r.away_team_id,r.away_team_abbr,r.away_team_name,r.home_score,r.away_score,r.source,r.observed_at,r.ingested_at,rowHash,archive.raw_r2_key,r.schema_version,r.build
+      ));
+      else statements.push(env.NFL_DB.prepare(SSOT_TEAM_UPSERT).bind(
+        r.game_id,r.bdl_game_id,r.season,r.week,r.season_type,r.team_id,r.team_abbr,r.team_name,r.opponent_team_id,r.opponent_abbr,r.home_away,r.first_downs,r.third_down_conversions,r.third_down_attempts,r.fourth_down_conversions,r.fourth_down_attempts,r.total_offensive_plays,r.total_yards,r.yards_per_play,r.total_drives,r.net_passing_yards,r.passing_completions,r.passing_attempts,r.yards_per_pass,r.sacks,r.sack_yards_lost,r.rushing_yards,r.rushing_attempts,r.yards_per_rush_attempt,r.red_zone_scores,r.red_zone_attempts,r.penalties,r.penalty_yards,r.turnovers,r.fumbles_lost,r.interceptions_thrown,r.defensive_touchdowns,r.possession_time_seconds,r.source,r.observed_at,r.ingested_at,rowHash,archive.raw_r2_key,r.schema_version,r.build
+      ));
+    }
+    if (statements.length) { const results = await env.NFL_DB.batch(statements); stored += results.length; }
+  }
+  return stored;
+}
