+async function handleSsot(req, env, origin, pathname, url) {
+  if (pathname === "/ssot/health" && req.method === "GET") return ok({ build: BUILD, schema_version: NFL_SSOT_SCHEMA_VERSION, role: "unified_brain_v8_factual_ssot", model_math_mutated: false, bindings: ssotBindings(env) }, {}, origin);
+  if (pathname === "/ssot/audit/season" && req.method === "GET") {
+    if (!env?.NFL_DB) return fail("ssot_missing_NFL_DB_binding",500,{},origin);
+    const season=ssotSeason(url.searchParams.get("season")||2025);
+    const cert=await env.NFL_DB.prepare("SELECT * FROM nfl_ssot_certifications WHERE season=? ORDER BY season_type,phase").bind(season).all();
+    const games=await env.NFL_DB.prepare("SELECT season_type,status_state,COUNT(*) n FROM nfl_games WHERE season=? GROUP BY season_type,status_state").bind(season).all();
+    const stats=await env.NFL_DB.prepare("SELECT season_type,COUNT(*) n FROM nfl_team_game_stats WHERE season=? GROUP BY season_type").bind(season).all();
+    return ok({season,certifications:cert.results||[],game_counts:games.results||[],team_stat_counts:stats.results||[]},{},origin);
+  }
+  if (pathname === "/ssot/debug/run" && req.method === "GET") {
+    if (!env?.NFL_DB) return fail("ssot_missing_NFL_DB_binding",500,{},origin);
+    const runId=url.searchParams.get("run_id"); if(!runId) return fail("ssot_missing_run_id",400,{},origin);
+    const run=await ssotGetRun(env,runId); if(!run) return fail("ssot_run_not_found",404,{},origin);
+    const rec=await env.NFL_DB.prepare("SELECT * FROM nfl_ssot_receipts WHERE run_id=? ORDER BY created_at").bind(runId).all();
+    return ok({run,receipts:rec.results||[]},{},origin);
+  }
+  if (pathname === "/ssot/debug/game" && req.method === "GET") {
+    if (!env?.NFL_DB) return fail("ssot_missing_NFL_DB_binding",500,{},origin);
+    const id=ssotInt(url.searchParams.get("bdl_game_id")); if(!id) return fail("ssot_invalid_bdl_game_id",400,{},origin);
+    const game=await env.NFL_DB.prepare("SELECT * FROM nfl_games WHERE bdl_game_id=?").bind(id).first(); if(!game) return fail("ssot_game_not_found",404,{},origin);
+    const stats=await env.NFL_DB.prepare("SELECT * FROM nfl_team_game_stats WHERE game_id=? ORDER BY home_away").bind(game.game_id).all(); return ok({game,team_stats:stats.results||[]},{},origin);
+  }
+  if (req.method === "POST") {
+    const auth=await ssotRequireAdmin(req,env); if(!auth.ok) return fail(auth.error,auth.status,{},origin);
+    if (pathname === "/ssot/bootstrap") {
+      if(!env?.NFL_DB) return fail("ssot_missing_NFL_DB_binding",500,{},origin);
+      const result=await env.NFL_DB.exec(NFL_SSOT_SCHEMA_SQL); return ok({schema_version:NFL_SSOT_SCHEMA_VERSION,result},{},origin);
+    }
+    const body=await readJson(req);
+    if (pathname === "/ssot/ingest/games") return ok(await ssotRunIngest(env,body,"games"),{},origin);
+    if (pathname === "/ssot/ingest/team-stats") return ok(await ssotRunIngest(env,body,"team_stats"),{},origin);
+    if (pathname === "/ssot/certify/games") { const c=await ssotCertifyGames(env,body.season,body.season_type); return c.certified?ok(c,{},origin):fail("ssot_games_not_certified",409,c,origin); }
+    if (pathname === "/ssot/certify/team-stats") { const c=await ssotCertifyTeamStats(env,body.season,body.season_type); return c.certified?ok(c,{},origin):fail("ssot_team_stats_not_certified",409,c,origin); }
+  }
+  return fail("ssot_not_found",404,{pathname},origin);
+}
